# Supabase project URL (client and server)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase public anonymous API key (client and server)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase administrative service role secret key (SERVER-ONLY)
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key for AI photo analysis (SERVER-ONLY)
GEMINI_API_KEY=

# Exact model name copied from the model list in Google AI Studio (SERVER-ONLY)
GEMINI_MODEL=
